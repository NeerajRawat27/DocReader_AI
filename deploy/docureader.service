[Unit]
Description=DocuReader AI Document Intelligence Service
After=syslog.target network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/docureader/backend
Environment="JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64"
Environment="SPRING_PROFILES_ACTIVE=prod"
Environment="OPENAI_API_KEY=your_openai_or_groq_api_key_here"
Environment="OPENAI_BASE_URL=https://api.groq.com/openai/v1"
Environment="OPENAI_MODEL=qwen/qwen3.8-27b"
ExecStart=/usr/bin/java -Xms512m -Xmx2048m -jar /opt/docureader/backend/docureader-ai-backend-1.0.0.jar
SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
